# android/keystore.properties  —  copy to keystore.properties and fill in.
#
# This file is git-ignored. Never commit it, never paste its contents in chat,
# and keep a copy of the .keystore binary in a password manager + offline backup.
#
# Generate the keystore once (Android Studio ships a JDK at
# "C:\Program Files\Android\Android Studio\jbr"):
#   keytool -genkeypair -v -storetype PKCS12 -keystore android/app/kehadiranpro-release.keystore \
#     -alias kehadiranpro -keyalg RSA -keysize 2048 -validity 10000
#
KEPASS_STORE_FILE=kehadiranpro-release.keystore
KEPASS_STORE_PASSWORD=change-me
KEPASS_KEY_ALIAS=kehadiranpro
KEPASS_KEY_PASSWORD=change-me
