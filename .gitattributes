# Keep line endings consistent so CI (Linux) and Windows behave the same.
# CRLF in a .sh file makes bash fail with "command not found" style errors.
* text=auto eol=lf

*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.ttf   binary
*.jar   binary
*.keystore binary
